{
  "name": "ember-qunit-nice-errors",
  "version": "2.0.0",
  "description": "Babel plugin that gives message-less QUnit assertions a message: their own source text.",
  "keywords": [
    "babel",
    "babel-plugin",
    "qunit",
    "assert",
    "assertion",
    "testing",
    "ember",
    "error",
    "message"
  ],
  "homepage": "https://github.com/adopted-ember-addons/ember-qunit-nice-errors#readme",
  "bugs": "https://github.com/adopted-ember-addons/ember-qunit-nice-errors/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/adopted-ember-addons/ember-qunit-nice-errors.git"
  },
  "license": "MIT",
  "author": "WyeWorks",
  "contributors": [
    "Samanta de Barros <samanta.debarros.cejas@gmail.com> (https://github.com/sdebarros)",
    "Federico Kauffman <fede.kau@gmail.com> (https://github.com/fedekau)",
    "Diego Acosta <acostami@gmail.com> (https://github.com/acostami)",
    "Santiago Ferreira <san650@gmail.com> (https://github.com/san650)",
    "Robbie Wagner <rwwagner90@gmail.com> (https://github.com/RobbieTheWagner)"
  ],
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:format": "prettier . --cache --check",
    "format": "prettier . --cache --write",
    "test": "node --test test/",
    "test:watch": "node --test --watch test/"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.21.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "release-plan": "^0.17.0",
    "@babel/core": "^7.28.0"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0 || ^8.0.0"
  },
  "packageManager": "pnpm@10.14.0-0+sha512.2cd47a0cbf5f1d1de7693a88307a0ede5be94e0d3b34853d800ee775efbea0650cb562b77605ec80bc8d925f5cd27c4dfe8bb04d3a0b76090784c664450d32d6",
  "engines": {
    "node": "^20.13.0 || >= 22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "type": "commonjs",
  "main": "./src/index.cjs",
  "exports": {
    ".": "./src/index.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ]
}
